generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String
  role           String         @default("USER") // USER, ADMIN, EDITOR
  image          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  comments       Comment[]
  ratings        Rating[]
  watchlist      Watchlist[]
  watchHistory   WatchHistory[]
  activityLogs   ActivityLog[]

  @@index([email])
}

model Movie {
  id             String         @id @default(cuid())
  titleKurdish   String
  titleOriginal  String
  slug           String         @unique
  year           Int
  duration       Int            @default(0) // in minutes
  rating         Float          @default(0.0)
  quality        String         @default("HD") // 4K, 1080p, HD, CAM
  language       String         @default("کوردی (ژێرنووس)")
  countryId      String?
  country        Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  synopsis       String
  poster         String
  backdrop       String
  trailerUrl     String?
  featured       Boolean        @default(false)
  status         String         @default("PUBLISHED") // PUBLISHED, DRAFT
  views          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  genres         MovieGenre[]
  credits        Credit[]
  servers        Server[]
  downloadLinks  DownloadLink[]
  comments       Comment[]
  ratings        Rating[]
  watchlists     Watchlist[]
  watchHistories WatchHistory[]
  brokenReports  BrokenReport[]
  reactions      Reaction[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([views])
  @@index([createdAt])
  @@index([year])
}

model Series {
  id             String         @id @default(cuid())
  titleKurdish   String
  titleOriginal  String
  slug           String         @unique
  year           Int
  rating         Float          @default(0.0)
  quality        String         @default("HD")
  language       String         @default("کوردی (ژێرنووس)")
  countryId      String?
  country        Country?       @relation(fields: [countryId], references: [id], onDelete: SetNull)
  synopsis       String
  poster         String
  backdrop       String
  trailerUrl     String?
  featured       Boolean        @default(false)
  status         String         @default("PUBLISHED")
  views          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  genres         SeriesGenre[]
  credits        Credit[]
  seasons        Season[]
  episodes       Episode[]
  ratings        Rating[]
  watchlists     Watchlist[]
  reactions      Reaction[]

  @@index([slug])
  @@index([status])
  @@index([featured])
  @@index([views])
  @@index([createdAt])
}

model Season {
  id             String         @id @default(cuid())
  seriesId       String
  series         Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number         Int
  titleKurdish   String?
  titleOriginal  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  episodes       Episode[]

  @@unique([seriesId, number])
  @@index([seriesId])
}

model Episode {
  id             String         @id @default(cuid())
  seasonId       String
  season         Season         @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seriesId       String
  series         Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  number         Int
  titleKurdish   String
  titleOriginal  String?
  duration       Int            @default(0) // in minutes
  rating         Float          @default(0)
  thumbnail      String?
  airDate        String?
  views          Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  servers        Server[]
  downloadLinks  DownloadLink[]
  comments       Comment[]
  watchHistories WatchHistory[]
  brokenReports  BrokenReport[]

  @@unique([seasonId, number])
  @@index([seasonId])
  @@index([seriesId])
}

model Genre {
  id             String         @id @default(cuid())
  nameKurdish    String
  nameOriginal   String
  slug           String         @unique
  order          Int            @default(0)
  createdAt      DateTime       @default(now())

  movieGenres    MovieGenre[]
  seriesGenres   SeriesGenre[]
  homeRows       HomeRow[]

  @@index([slug])
}

model Country {
  id             String         @id @default(cuid())
  nameKurdish    String
  nameOriginal   String
  code           String         @unique
  createdAt      DateTime       @default(now())

  movies         Movie[]
  series         Series[]
}

model Person {
  id             String         @id @default(cuid())
  nameKurdish    String
  nameOriginal   String
  slug           String         @unique
  photo          String?
  biography      String?
  createdAt      DateTime       @default(now())

  credits        Credit[]

  @@index([slug])
}

model MovieGenre {
  id             String         @id @default(cuid())
  movieId        String
  movie          Movie          @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genreId        String
  genre          Genre          @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([movieId, genreId])
  @@index([movieId])
  @@index([genreId])
}

model SeriesGenre {
  id             String         @id @default(cuid())
  seriesId       String
  series         Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genreId        String
  genre          Genre          @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@unique([seriesId, genreId])
  @@index([seriesId])
  @@index([genreId])
}

model Credit {
  id             String         @id @default(cuid())
  personId       String
  person         Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId       String?
  series         Series?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  role           String         @default("ACTOR") // ACTOR, DIRECTOR, WRITER
  characterName  String?
  order          Int            @default(0)

  @@index([personId])
  @@index([movieId])
  @@index([seriesId])
}

model Server {
  id             String         @id @default(cuid())
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId      String?
  episode        Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  label          String         // e.g. "سێرڤەر ١", "Vidmoly VIP"
  provider       String         // "vidmoly", "gdrive", "sharevids", "custom", "youtube"
  url            String         // Clean normalized embed URL
  quality        String?        @default("1080p")
  subtitleNote   String?        @default("ژێرنووسی کوردی")
  order          Int            @default(0)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  brokenReports  BrokenReport[]

  @@index([movieId])
  @@index([episodeId])
  @@index([active])
}

model DownloadLink {
  id             String         @id @default(cuid())
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId      String?
  episode        Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  label          String         // e.g. "داگرتن بە کوالیتی 1080p"
  url            String
  quality        String         @default("1080p")
  fileSize       String?        // e.g. "1.8 GB"
  createdAt      DateTime       @default(now())

  @@index([movieId])
  @@index([episodeId])
}

model Comment {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId      String?
  episode        Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  content        String
  approved       Boolean        @default(true)
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([movieId])
  @@index([episodeId])
}

model Rating {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId       String?
  series         Series?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  score          Float          // 1 - 10
  createdAt      DateTime       @default(now())

  @@unique([userId, movieId])
  @@unique([userId, seriesId])
}

model Watchlist {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId       String?
  series         Series?        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([movieId])
  @@index([seriesId])
}

model WatchHistory {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  movieId         String?
  movie           Movie?        @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId       String?
  episode         Episode?      @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  progressSeconds Int           @default(0)
  durationSeconds Int           @default(0)
  completed       Boolean       @default(false)
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([movieId])
  @@index([episodeId])
}

model BrokenReport {
  id             String         @id @default(cuid())
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id], onDelete: Cascade)
  episodeId      String?
  episode        Episode?       @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  serverId       String?
  server         Server?        @relation(fields: [serverId], references: [id], onDelete: SetNull)
  note           String?
  status         String         @default("PENDING") // PENDING, FIXED, IGNORED
  reporterIp     String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  @@index([status])
  @@index([movieId])
  @@index([episodeId])
}

model HomeRow {
  id             String         @id @default(cuid())
  titleKurdish   String
  titleOriginal  String?
  subtitle       String?
  type           String         @default("MOVIE") // MOVIE, SERIES, MIXED
  rule           String         @default("LATEST") // LATEST, MOST_VIEWED, GENRE, FEATURED, TOP_RATED, HAND_PICKED
  genreId        String?
  genre          Genre?         @relation(fields: [genreId], references: [id], onDelete: SetNull)
  customIds      String?        // JSON array of movie/series ids for HAND_PICKED
  order          Int            @default(0)
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  @@index([active])
  @@index([order])
}

model SiteSetting {
  id             String         @id @default(cuid())
  key            String         @unique
  value          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([key])
}

model ActivityLog {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  details        String?
  ipAddress      String?
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Reaction {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String?
  movieId   String?
  movie     Movie?   @relation(fields: [movieId], references: [id], onDelete: Cascade)
  seriesId  String?
  series    Series?  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  emoji     String   @default("❤️")
  createdAt DateTime @default(now())

  @@index([movieId])
  @@index([seriesId])
}
