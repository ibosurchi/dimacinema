# Database (Default SQLite for zero-config local run, or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# Example PostgreSQL for Neon / Supabase / Docker:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dima_cinema?schema=public"

# NextAuth Authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dima-cinema-super-secure-production-jwt-secret-key-32chars"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional TMDB API key for admin metadata auto-import
# TMDB_API_KEY="your_tmdb_v3_api_key_here"
